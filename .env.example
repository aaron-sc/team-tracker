DATABASE_URL="file:./dev.db"
# Generate with: openssl rand -base64 32
AUTH_SECRET=""

# Get a free key at https://resend.com/api-keys — no domain needed, emails send
# from onboarding@resend.dev until you verify your own domain. Leave unset to
# fall back to the copyable invite link (no email sent, no error either).
RESEND_API_KEY=""
# EMAIL_FROM="Formation <onboarding@resend.dev>"

# Required in production so NextAuth issues correct callback/redirect URLs,
# and so email links point at the right place. Local dev doesn't need this —
# it's auto-detected from the request.
# AUTH_URL="https://formation.yourdomain.example"
# APP_URL="https://formation.yourdomain.example"

# Formation acts as the OpenID Connect identity provider for the esports-tools.com product family
# (the hub, Vault sign in "with Formation" — see lib/oauth/ and app/oauth/*). Generate the keypair
# once with:
#   node -e "const{privateKey,publicKey}=require('crypto').generateKeyPairSync('rsa',{modulusLength:2048,privateKeyEncoding:{type:'pkcs8',format:'pem'},publicKeyEncoding:{type:'spki',format:'pem'}});console.log('OIDC_PRIVATE_KEY='+Buffer.from(privateKey).toString('base64url'));console.log('OIDC_PUBLIC_KEY='+Buffer.from(publicKey).toString('base64url'))"
# Required before any /oauth/* route works — there's no fallback.
# OIDC_PRIVATE_KEY=""
# OIDC_PUBLIC_KEY=""

# Docker self-hosting only (see docker-compose.yml / Caddyfile). DOMAIN is
# what Caddy serves the app on; APEX_DOMAIN redirects to it — useful if you
# host other tools on the same bare domain and want each on its own subdomain.
# DOMAIN="formation.yourdomain.example"
# APEX_DOMAIN="yourdomain.example"
# VAULT_DOMAIN is a second site block for a separate app (Vault) sharing this same Caddy
# instance/VM — see Caddyfile and docker-compose.yml's "esports-tools-shared" network. Leave
# unset if you're not also running that app here.
# VAULT_DOMAIN="vault.yourdomain.example"

# Browser push notifications (Web Push). Generate a pair once with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Leave unset and the feature just stays hidden — no error either way.
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@yourdomain.example"
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=""  # same value as VAPID_PUBLIC_KEY — also read client-side

# Discord bot (slash commands: /link, /connect, /available) — separate from the plain webhook
# integration above, which needs no setup here. Create an application at
# https://discord.com/developers/applications, add a Bot, and copy its token; the client ID is
# the Application ID on the same page. Leave unset and the bot just stays offline — no error.
# DISCORD_BOT_TOKEN=""
# DISCORD_CLIENT_ID=""

# Game stats sync (roster profile "Sync stats" button) — each is independent and optional; the
# button just says what's not configured yet if its key is missing.
# Riot (League of Legends only — Valorant's official API doesn't expose ranked data to personal
# keys). Get a personal key at https://developer.riotgames.com (expires in 24h; apply for a
# production key for anything long-running). RIOT_PLATFORM is the shard your players are on
# (na1, euw1, kr, ...) — Riot doesn't expose this from a Riot ID lookup alone.
# RIOT_API_KEY=""
# RIOT_PLATFORM="na1"
# Steam — get a key at https://steamcommunity.com/dev/apikey
# STEAM_API_KEY=""

# "Feature request" button in the top nav — posts to this single, operator-owned Discord webhook
# (Server Settings → Integrations → Webhooks in whatever server you want requests to land in).
# Unrelated to any org's own Discord integration settings. Leave unset and the button just shows
# an error instead of silently failing.
# FEEDBACK_DISCORD_WEBHOOK_URL=""

# Access requests — signup at /signup is invite-only. Each request is posted for you to
# Approve / Deny.
#   Preferred: the Discord bot (DISCORD_BOT_TOKEN above) posts to this channel with buttons.
#   Turn on Developer Mode in Discord, then right-click the channel → Copy Channel ID.
# ACCESS_REQUEST_DISCORD_CHANNEL_ID=""
#   Fallback if the bot isn't running: a plain webhook (no buttons — you approve via a signed
#   link in the message). Falls back further to FEEDBACK_DISCORD_WEBHOOK_URL if this is unset.
# ACCESS_REQUEST_DISCORD_WEBHOOK_URL=""
# The approve/deny links are HMAC-signed with AUTH_SECRET; set APP_URL (above) so they're
# absolute. With neither a bot channel nor a webhook set, the approve link is only logged to
# the server console.

# Google Analytics (GA4) — only loads after a visitor accepts the cookie consent banner, and only
# if this is set at all. Get a Measurement ID (starts with "G-") from
# https://analytics.google.com by creating a GA4 property for your domain.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=""
