{$DOMAIN} {
	reverse_proxy app:3300

	# Formation's own container briefly drops off the network during a deploy (the old one stops
	# right before the new one starts — docker-entrypoint.sh then still has migrations + `next
	# start` to get through). reverse_proxy surfaces that gap as 502/503/504; show something better
	# than Caddy's bare error page for exactly those three, not real app-level errors (a genuine
	# Next.js 500 shouldn't claim to be a deploy). See caddy/maintenance/index.html — update its
	# feature bullets alongside any deploy you actually want described there.
	handle_errors {
		@deploying expression `{http.error.status_code} == 502 || {http.error.status_code} == 503 || {http.error.status_code} == 504`
		handle @deploying {
			root * /srv/maintenance
			rewrite * /index.html
			file_server
		}
	}
}

# The bare domain now serves the product hub — a separate app/repo/container (see the "Vault"
# comment below for the pattern) rather than just redirecting to Formation. "www." still redirects
# to the apex, same as before.
{$APEX_DOMAIN} {
	reverse_proxy hub-app:3500
}

www.{$APEX_DOMAIN} {
	redir https://{$APEX_DOMAIN}{uri} permanent
}

# Vault (sponsorship/finance suite) — a separate app/repo/container sharing this VM and this one
# Caddy instance. Its own compose file joins the "esports-tools-shared" external network
# (created once via `docker network create esports-tools-shared`) so it's reachable here by
# service name; that repo has no Caddy of its own.
{$VAULT_DOMAIN} {
	reverse_proxy vault-app:3400
}

# The personal admin console (see esports-hub's app/admin/*) — same container as the bare apex
# domain above, just a second hostname answering it. The hub's own /admin/layout.tsx is what
# actually restricts this to one person; there's nothing subdomain-specific happening here.
{$ADMIN_DOMAIN} {
	reverse_proxy hub-app:3500
}
